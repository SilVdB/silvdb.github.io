---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
// import EssayCard from '../components/EssayCard.astro';  // re-enable with writing section
import FeedEntry from '../components/FeedEntry.astro';
import { dateFromFeedId } from '../lib/feedDate';

// const essays = await getCollection('essays', (e) => e.data.status !== 'draft');  // re-enable with writing section
// const latestEssays = essays
//   .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
//   .slice(0, 3);

const feedEntries = await getCollection('feed');
const latestFeed = feedEntries
  .map((e) => ({ entry: e, date: e.data.date ?? dateFromFeedId(e.id) }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-heading text-display font-bold text-charcoal">Silke Van den Broeck</h1>
    <p class="mt-3 text-lg text-charcoal font-body">
      Thinking about <mark>software, nervous systems and herbalism</mark>, and sometimes writing about it.
    </p>

    {/* Writing section — re-enable when first essay is ready
    <section class="mt-16">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-body text-xs font-medium uppercase tracking-widest text-charcoal/40">Writing</h2>
        <a href="/writing" class="font-body text-xs text-charcoal/40 hover:text-pink transition-colors">All writing →</a>
      </div>
      {latestEssays.length === 0
        ? <p class="text-charcoal/50 font-body italic py-4">No essays yet.</p>
        : latestEssays.map((essay) => <EssayCard essay={essay} />)
      }
    </section>
    */}

    <section class="mt-16">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="font-body text-xs font-medium uppercase tracking-widest text-charcoal/40">Feed</h2>
        <a href="/feed" class="font-body text-xs text-charcoal/40 hover:text-pink transition-colors">All entries →</a>
      </div>
      {latestFeed.length === 0
        ? <p class="text-charcoal/50 font-body italic py-4">No feed entries yet.</p>
        : latestFeed.map(({ entry }) => <FeedEntry entry={entry} />)
      }
    </section>
  </div>
</Layout>
