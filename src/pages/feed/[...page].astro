---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FeedEntry from '../../components/FeedEntry.astro';
import { dateFromFeedId } from '../../lib/feedDate';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allEntries = await getCollection('feed');
  const sorted = allEntries
    .map((e) => ({ entry: e, date: e.data.date ?? dateFromFeedId(e.id) }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
  return paginate(sorted, { pageSize: 8 });
}

const { page } = Astro.props;
const { data: entries, currentPage, lastPage, url } = page;
---

<Layout title={currentPage === 1 ? 'Feed' : `Feed — Page ${currentPage}`} description="Seeds, scraps, and things worth keeping.">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-heading text-headline font-bold text-charcoal">Feed</h1>
    <p class="mt-3 text-charcoal/70 font-body">Seeds, scraps, and things worth keeping.</p>

    <div class="mt-10">
      {entries.length === 0 ? (
        <p class="text-charcoal/50 font-body italic">No entries yet.</p>
      ) : (
        entries.map(({ entry }: { entry: any }) => <FeedEntry entry={entry} />)
      )}
    </div>

    {lastPage > 1 && (
      <nav class="mt-12 flex items-center justify-between" aria-label="Feed pagination">
        <div>
          {url.prev ? (
            <a href={url.prev} class="font-body text-sm text-charcoal/60 hover:text-pink transition-colors">← Newer</a>
          ) : (
            <span class="font-body text-sm text-charcoal/30">← Newer</span>
          )}
        </div>
        <span class="font-body text-xs text-charcoal/40 uppercase tracking-widest">
          {currentPage} / {lastPage}
        </span>
        <div>
          {url.next ? (
            <a href={url.next} class="font-body text-sm text-charcoal/60 hover:text-pink transition-colors">Older →</a>
          ) : (
            <span class="font-body text-sm text-charcoal/30">Older →</span>
          )}
        </div>
      </nav>
    )}
  </div>
</Layout>
