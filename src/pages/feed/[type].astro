---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FeedEntry from '../../components/FeedEntry.astro';
import { dateFromFeedId } from '../../lib/feedDate';

export async function getStaticPaths() {
  const allEntries = await getCollection('feed');
  const allTypes = [...new Set(allEntries.map((e) => e.data.type))].sort();
  return allTypes.map((type) => ({ params: { type } }));
}

const { type } = Astro.params as { type: string };

const allEntries = await getCollection('feed', (e) => e.data.type === type);
const sorted = allEntries
  .map((e) => ({ entry: e, date: e.data.date ?? dateFromFeedId(e.id) }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout title="Feed" description="A stream of poems, thoughts, and fragments.">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-heading text-headline font-bold text-charcoal">Feed</h1>
    <p class="mt-3 text-charcoal/70 font-body">A stream of poems, thoughts, and fragments.</p>

    <div class="mt-10">
      {sorted.length === 0 ? (
        <p class="text-charcoal/50 font-body italic">No entries of this type yet.</p>
      ) : (
        sorted.map(({ entry }) => <FeedEntry entry={entry} />)
      )}
    </div>
  </div>
</Layout>
