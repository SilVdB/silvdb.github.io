---
import AboutContent from '../content/about.mdx';
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Silke Van den Broeck.">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-heading text-headline font-bold text-charcoal">About</h1>
    <img
      src="/sil.jpg"
      alt="Silke Van den Broeck"
      class="w-full aspect-[3/4] object-cover object-[50%_10%] rounded-sm mt-8 mb-2"
    />
    <article class="mt-6 prose-notebook">
      <AboutContent />
    </article>
  </div>
</Layout>
