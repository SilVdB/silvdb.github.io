---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { THEMES } from '../../lib/themes';

const essays = await getCollection('essays', (e) => e.data.status !== 'draft');

const themeCounts = Object.fromEntries(
  THEMES.map((t) => [t.slug, essays.filter((e) => e.data.themes.includes(t.slug)).length])
);
---

<Layout title="Writing" description="Essays on intelligence, mind, ecology, and meaning.">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-heading text-headline font-bold text-charcoal">Writing</h1>
    <p class="mt-3 text-charcoal/70 font-body">
      Essays across four domains of inquiry.
    </p>

    <div class="mt-10 grid sm:grid-cols-2 gap-4">
      {THEMES.map((theme) => (
        <ThemeCard
          slug={theme.slug}
          label={theme.label}
          description={theme.description}
          count={themeCounts[theme.slug] ?? 0}
        />
      ))}
    </div>
  </div>
</Layout>
