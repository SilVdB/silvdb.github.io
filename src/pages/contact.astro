---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Silke Van den Broeck.">
  <div class="max-w-prose-col mx-auto px-6 py-24 text-center">
    <h1 class="font-heading text-3xl font-bold text-charcoal mb-10">Contact</h1>
    <ul class="contact-links space-y-4 list-none p-0">
      <li>
        <a
          href="mailto:>[email redacted]"
          class="font-body text-lg text-charcoal hover:text-pink transition-colors"
        >
          >[email redacted]
        </a>
      </li>
      <li>
        <a
          href="https://linkedin.com/in/silkevdb"
          rel="noopener noreferrer"
          class="font-body text-lg text-charcoal hover:text-pink transition-colors"
        >
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href="https://github.com/SilVdB"
          rel="noopener noreferrer"
          class="font-body text-lg text-charcoal hover:text-pink transition-colors"
        >
          GitHub
        </a>
      </li>
    </ul>
  </div>
</Layout>
