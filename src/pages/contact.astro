---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Silke Van den Broeck.">
  <div class="max-w-prose-col mx-auto px-6 py-16">
    <h1 class="font-body text-xs font-medium uppercase tracking-widest text-charcoal/40 mb-8">Contact</h1>

    <div class="bg-charcoal rounded-sm overflow-hidden">

      <div class="px-10 py-10">
        <img
          src="/logo.svg"
          alt="Silke Van den Broeck"
          class="h-7 w-auto"
          style="filter: brightness(0) invert(1); opacity: 0.85;"
        />
        <div class="mt-10">
          <p class="font-heading text-2xl font-semibold text-cream">Silke Van den Broeck</p>
          <p class="mt-2 font-body text-sm text-cream/50">Software engineer · AI-native thinker · writer</p>
        </div>
      </div>

      <div class="mx-10 border-t border-cream/10"></div>

      <div class="px-10 py-8 space-y-3">
        <a
          href="mailto:>[email redacted]"
          class="block font-body text-sm text-cream/60 hover:text-cream transition-colors"
        >
          >[email redacted]
        </a>
        <a
          href="https://linkedin.com/in/silkevdb"
          rel="noopener noreferrer"
          class="block font-body text-sm text-cream/60 hover:text-cream transition-colors"
        >
          linkedin.com/in/silkevdb
        </a>
        <a
          href="https://github.com/SilVdB"
          rel="noopener noreferrer"
          class="block font-body text-sm text-cream/60 hover:text-cream transition-colors"
        >
          github.com/SilVdB
        </a>
      </div>

    </div>
  </div>
</Layout>
