---
interface Props {
  slug: string;
  label: string;
  description: string;
  count: number;
}

const { slug, label, description, count } = Astro.props;
---

<a
  href={`/writing/${slug}`}
  class="block p-6 border border-lavender/30 rounded-lg hover:border-lavender hover:shadow-sm transition-all group"
>
  <div class="flex items-start justify-between gap-4">
    <h2 class="font-heading font-semibold text-xl text-charcoal group-hover:text-pink transition-colors">
      {label}
    </h2>
    <span class="shrink-0 text-sm font-body text-charcoal/50">{count} {count === 1 ? 'essay' : 'essays'}</span>
  </div>
  <p class="mt-2 text-sm text-charcoal/70 font-body leading-relaxed">{description}</p>
</a>
