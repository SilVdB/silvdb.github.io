---
import type { CollectionEntry } from 'astro:content';
import { THEMES } from '../lib/themes';

interface Props {
  essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const { title, date, themes, description } = essay.data;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const validThemes = THEMES.filter((t) => themes.includes(t.slug));
---

<article class="py-4 border-b border-lavender/30 last:border-0">
  <div class="flex items-center gap-2 mb-1">
    <span class="text-xs font-body font-medium uppercase tracking-widest bg-lavender text-charcoal px-2 py-0.5 rounded-full">
      essay
    </span>
    <time datetime={date.toISOString()} class="text-xs text-charcoal/50 font-body">
      {formattedDate}
    </time>
  </div>
  <h2 class="font-heading font-semibold text-lg text-charcoal">
    <a href={`/writing/${essay.id}`} class="hover:text-pink transition-colors">{title}</a>
  </h2>
  {description && (
    <p class="mt-1 text-sm text-charcoal/70 font-body leading-relaxed">{description}</p>
  )}
  {validThemes.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1">
      {validThemes.map((theme) => (
        <a
          href={`/writing/${theme.slug}`}
          class="text-xs font-body text-charcoal/60 hover:text-pink transition-colors"
        >
          #{theme.label}
        </a>
      ))}
    </div>
  )}
</article>
