---
interface Props {
  code: string;
}
const { code } = Astro.props;
---

<figure class="my-8 overflow-x-auto">
  <pre class="mermaid text-sm">{code}</pre>
</figure>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      primaryColor: '#D8C5E8',
      primaryTextColor: '#2A2D2B',
      primaryBorderColor: 'rgba(216,197,232,0.7)',
      lineColor: '#2A2D2B',
      background: '#F7F4EF',
      mainBkg: '#F7F4EF',
      edgeLabelBackground: '#F7F4EF',
      clusterBkg: '#F7F4EF',
      fontFamily: "'Open Sans', sans-serif",
      fontSize: '13px',
    },
    flowchart: { curve: 'basis' },
  });

  mermaid.run({ querySelector: '.mermaid' });
</script>
