---
import EmailLink from './EmailLink.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-lavender/30 mt-auto">
  <div class="max-w-wide mx-auto px-6 py-6 flex items-center justify-between gap-6">
    <p class="font-body text-xs text-charcoal/40">
      © {year} Silke Van den Broeck
    </p>
    <nav aria-label="Social links" class="flex items-center gap-5">
      <EmailLink
        label="Email"
        class="font-body text-xs text-charcoal/40 hover:text-pink transition-colors"
      />
      <a
        href="https://linkedin.com/in/silkevdb"
        rel="noopener noreferrer"
        class="font-body text-xs text-charcoal/40 hover:text-pink transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/SilVdB"
        rel="noopener noreferrer"
        class="font-body text-xs text-charcoal/40 hover:text-pink transition-colors"
      >
        GitHub
      </a>
    </nav>
  </div>
</footer>
