---
interface Props {
  class?: string;
  label?: string; // if omitted, the full address is shown (filled in by JS)
}
const { class: className, label } = Astro.props;
---

<a href="#" data-u="silkevdb" data-d="gmail.com" class={className}>
  {label ?? ''}
</a>

<script>
  for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-u][data-d]')) {
    const email = el.dataset.u + '@' + el.dataset.d;
    el.href = 'mailto:' + email;
    if (!el.textContent?.trim()) el.textContent = email;
  }
</script>
