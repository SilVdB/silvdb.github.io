---
interface Props {
  class?: string;
  label?: string; // if omitted, the full address is shown (filled in by JS)
  noLink?: boolean; // render as plain text span instead of anchor
}
const { class: className, label, noLink = false } = Astro.props;
---

{noLink ? (
  <span data-u="silkevdb" data-d="gmail.com" class={className}>
    {label ?? ''}
  </span>
) : (
  <a href="#" data-u="silkevdb" data-d="gmail.com" class={className}>
    {label ?? ''}
  </a>
)}

<script>
  for (const el of document.querySelectorAll('[data-u][data-d]')) {
    const email = (el as HTMLElement).dataset.u + '@' + (el as HTMLElement).dataset.d;
    if (el.tagName === 'A') (el as HTMLAnchorElement).href = 'mailto:' + email;
    if (!el.textContent?.trim()) el.textContent = email;
  }
</script>
